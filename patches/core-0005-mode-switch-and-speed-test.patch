+// speedTestURL serves any number of bytes on request; one request is small
+// enough to finish, and the workers ask again until the time is up.
+const speedTestURL = "https://speed.cloudflare.com/__down?bytes=25000000"
+
+// speedTestConns is how many downloads run side by side, like the usual
+// speed tests do.
+const speedTestConns = 4
+
+// MeasureSpeed connects a Session client for specsJSON the way NodeVerify
+// does and downloads through the tunnel for about `seconds`, over several
+// connections at once: {"mbps", "bytes", "seconds", "connectMs", "live"}.
+// The clock starts at the first byte, so connecting and the TLS handshakes
+// are not counted. Only one connection can run at a time, so the app stops
+// its tunnel first.
+func MeasureSpeed(specsJSON, secret string, seconds int) string {
+	if ProxyIsRunning() || ExitIsRunning() || packetRunning() {
+		return failure(errors.New("сначала отключите текущее соединение"), nil)
+	}
+	if seconds < 3 {
+		seconds = 3
+	}
+	if seconds > 60 {
+		seconds = 60
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(seconds+100)*time.Second)
+	node.mu.Lock()
+	node.verifyCancel = cancel
+	node.mu.Unlock()
+	defer func() {
+		cancel()
+		node.mu.Lock()
+		node.verifyCancel = nil
+		node.mu.Unlock()
+	}()
+
+	appendLog("[NODE] Замер скорости: подключение")
+	started := time.Now()
+	trans, sess, err := buildSessionWith(specsJSON, secret, false, sessionOptions{strict: true})
+	if err != nil {
+		return failure(err, nil)
+	}
+	// Same order as StopProxy: the captcha side first, then the carriers.
+	defer func() {
+		detachCaptcha()
+		CancelCaptcha()
+		setAuthProxy(nil)
+		clearRoute()
+		_ = trans.Stop()
+	}()
+	if err := trans.Start(); err != nil {
+		return failure(err, nil)
+	}
+	for !trans.IsConnected() {
+		select {
+		case <-ctx.Done():
+			return failure(errors.New("нода не ответила: замер не начат"), nil)
+		case <-time.After(300 * time.Millisecond):
+		}
+	}
+	connectMs := time.Since(started).Milliseconds()
+
+	tun := tunnel.NewTCPTunnel(trans, false)
+	defer tun.Close()
+	httpClient := &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(_ context.Context, _, addr string) (net.Conn, error) {
+				return tun.DialTCP(addr)
+			},
+			TLSHandshakeTimeout: 30 * time.Second,
+			DisableCompression:  true,
+			MaxConnsPerHost:     speedTestConns,
+		},
+	}
+	defer httpClient.CloseIdleConnections()
+
+	var received atomic.Int64
+	var firstByte atomic.Int64 // UnixNano of the first byte, 0 before it
+	var lastErr atomic.Value
+	loadCtx, stopLoad := context.WithCancel(ctx)
+	defer stopLoad()
+	var workers sync.WaitGroup
+	for i := 0; i < speedTestConns; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			buf := make([]byte, 64*1024)
+			for loadCtx.Err() == nil {
+				req, _ := http.NewRequestWithContext(loadCtx, "GET", speedTestURL, nil)
+				req.Header.Set("User-Agent", "Mozilla/5.0")
+				resp, err := httpClient.Do(req)
+				if err != nil {
+					if loadCtx.Err() == nil {
+						lastErr.Store(err.Error())
+						select {
+						case <-loadCtx.Done():
+						case <-time.After(time.Second):
+						}
+					}
+					continue
+				}
+				if resp.StatusCode != 200 {
+					lastErr.Store(fmt.Sprintf("сервер замера ответил %d", resp.StatusCode))
+					resp.Body.Close()
+					select {
+					case <-loadCtx.Done():
+					case <-time.After(time.Second):
+					}
+					continue
+				}
+				for {
+					n, rerr := resp.Body.Read(buf)
+					if n > 0 {
+						firstByte.CompareAndSwap(0, time.Now().UnixNano())
+						received.Add(int64(n))
+					}
+					if rerr != nil {
+						break
+					}
+				}
+				resp.Body.Close()
+			}
+		}()
+	}
+
+	// Wait for the first byte, then let the downloads run for the asked time.
+	appendLog("[NODE] Замер скорости: загрузка")
+	for firstByte.Load() == 0 {
+		select {
+		case <-ctx.Done():
+			stopLoad()
+			workers.Wait()
+			reason, _ := lastErr.Load().(string)
+			if reason == "" {
+				reason = "нет ответа"
+			}
+			return failure(fmt.Errorf("канал поднялся, но загрузка через него не пошла: %s", reason), nil)
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+	select {
+	case <-ctx.Done():
+	case <-time.After(time.Duration(seconds) * time.Second):
+	}
+	total := received.Load()
+	elapsed := time.Since(time.Unix(0, firstByte.Load())).Seconds()
+	live := sess.LiveTransports()
+	stopLoad()
+	workers.Wait()
+	if elapsed <= 0 {
+		elapsed = 1
+	}
+	mbps := float64(total) * 8 / elapsed / 1e6
+	mbps = float64(int64(mbps*100+0.5)) / 100
+	appendLog(fmt.Sprintf("[NODE] Замер скорости: %.2f Мбит/с (%d байт за %.1f с)", mbps, total, elapsed))
+	return result(map[string]interface{}{
+		"mbps":      mbps,
+		"bytes":     total,
+		"seconds":   float64(int64(elapsed*10+0.5)) / 10,
+		"connectMs": connectMs,
+		"conns":     speedTestConns,
+		"live":      live,
+	})
+}
