+// NodeSetMode switches a channel already on the VDS to the "l3" or "l4" exit
+// backend: {"mode"}. Its documents, key and port stay, so saved profiles keep
+// working. A wrong sudo password comes back with "sudo": true.
+func NodeSetMode(channel, mode, sudoPassword string) string {
+	conn, err := nodeConn()
+	if err != nil {
+		return failure(err, nil)
+	}
+	channel = strings.TrimSpace(channel)
+	if err := conn.SetMode(channel, mode, sudoPassword); err != nil {
+		return failure(err, map[string]interface{}{"sudo": errors.Is(err, provision.ErrSudoPassword)})
+	}
+	appendLog("[NODE] Канал " + channel + ": режим " + mode)
+	return result(map[string]interface{}{"mode": mode})
+}
+
+// NodeProbe asks the connected VDS about itself again: {"probe"}.
+func NodeProbe() string {
+	conn, err := nodeConn()
+	if err != nil {
+		return failure(err, nil)
+	}
+	probe, err := conn.Probe()
+	if err != nil {
+		return failure(err, nil)
+	}
+	return result(map[string]interface{}{"probe": probe})
+}
