+// SetMode switches an installed channel between the l4 and l3 exit backends
+// and restarts it. The script puts the old mode back if the node does not
+// start in the new one.
+func (c *Conn) SetMode(channel, mode, sudoPassword string) error {
+	if channel == "" || strings.ContainsAny(channel, "\r\n") {
+		return errors.New("не указан канал")
+	}
+	if mode != "l3" && mode != "l4" {
+		return fmt.Errorf("неизвестный режим ноды %q", mode)
+	}
+	return c.asRoot("mode", "channel="+channel+"\nmode="+mode+"\n", sudoPassword)
+}
