+// scriptDiag says why a read-only script command gave no usable answer: what
+// it wrote and how the SSH command ended. probe and plan carry no secrets.
+func scriptDiag(command string, stdout, stderr []byte, runErr, parseErr error) string {
+	parts := []string{"команда " + command}
+	if s := firstLine(stderr); s != "" {
+		parts = append(parts, "stderr: "+s)
+	}
+	if runErr != nil {
+		parts = append(parts, "ssh: "+runErr.Error())
+	}
+	if out := []rune(strings.TrimSpace(string(stdout))); len(out) == 0 {
+		parts = append(parts, "вывод пуст")
+	} else {
+		if len(out) > 300 {
+			out = out[:300]
+		}
+		parts = append(parts, "вывод: "+string(out))
+	}
+	if parseErr != nil {
+		parts = append(parts, parseErr.Error())
+	}
+	return strings.Join(parts, "; ")
+}
