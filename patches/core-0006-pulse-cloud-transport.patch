@@ -0,0 +1,290 @@
+package s3box
+
+import (
+	"bytes"
+	"crypto/rand"
+	"encoding/xml"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/p1neappleXpress/OpenFlux/transport"
+)
+
+// Пример подписи из документации AWS (GET Object, «examplebucket»).
+func TestSigV4Vector(t *testing.T) {
+	tm, _ := time.Parse("20060102T150405Z", "20130524T000000Z")
+	h := map[string]string{
+		"host":                 "examplebucket.s3.amazonaws.com",
+		"range":                "bytes=0-9",
+		"x-amz-content-sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+		"x-amz-date":           "20130524T000000Z",
+	}
+	got := sign("GET", "/test.txt", url.Values{}, h, h["x-amz-content-sha256"], "us-east-1", "AKIAIOSFODNN7EXAMPLE", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", tm)
+	want := "Signature=f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41"
+	if !strings.HasSuffix(got, want) {
+		t.Fatalf("подпись не совпала с эталоном AWS:\n%s", got)
+	}
+}
+
+func TestParseURL(t *testing.T) {
+	c, err := ParseURL("ycloud", "AKID:se%2Fcr%2Bet@mybucket/tunnel1")
+	if err != nil || c.Host != "storage.yandexcloud.net" || c.Region != "ru-central1" || c.Bucket != "mybucket" || c.Prefix != "tunnel1" || c.SK != "se/cr+et" {
+		t.Fatalf("%+v %v", c, err)
+	}
+	c, err = ParseURL("ycloud", "YCAJE:raw/se+cret=@b2")
+	if err != nil || c.SK != "raw/se+cret=" || c.Bucket != "b2" || c.Prefix != "pulse" {
+		t.Fatalf("%+v %v", c, err)
+	}
+	c, err = ParseURL("vkcloud", "s3://AK:SK@hb.ru-msk.vkcs.cloud/b/p?region=ru-msk")
+	if err != nil || c.Host != "hb.ru-msk.vkcs.cloud" || c.Bucket != "b" || c.Prefix != "p" || c.Region != "ru-msk" {
+		t.Fatalf("%+v %v", c, err)
+	}
+}
+
+// ---------- поддельное хранилище S3 с задержкой как у настоящего ----------
+
+type fakeS3 struct {
+	mu      sync.Mutex
+	objs    map[string][]byte
+	mod     map[string]time.Time
+	lat     time.Duration
+	gets    atomic.Int64
+	puts    atomic.Int64
+	lists   atomic.Int64
+	authBad atomic.Int64
+}
+
+func (f *fakeS3) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	time.Sleep(f.lat)
+	if !strings.HasPrefix(r.Header.Get("Authorization"), "AWS4-HMAC-SHA256 Credential=AK/") {
+		f.authBad.Add(1)
+		w.WriteHeader(403)
+		return
+	}
+	w.Header().Set("Date", time.Now().UTC().Format(http.TimeFormat))
+	p := strings.SplitN(strings.TrimPrefix(r.URL.Path, "/"), "/", 2)
+	key := ""
+	if len(p) == 2 {
+		key = p[1]
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	switch {
+	case r.Method == "PUT":
+		b, _ := io.ReadAll(r.Body)
+		f.objs[key], f.mod[key] = b, time.Now()
+		f.puts.Add(1)
+	case r.Method == "DELETE":
+		delete(f.objs, key)
+	case r.Method == "GET" && key == "":
+		f.lists.Add(1)
+		q := r.URL.Query()
+		var ks []string
+		for k := range f.objs {
+			if strings.HasPrefix(k, q.Get("prefix")) && k > q.Get("start-after") {
+				ks = append(ks, k)
+			}
+		}
+		sort.Strings(ks)
+		if m, _ := strconv.Atoi(q.Get("max-keys")); m > 0 && len(ks) > m {
+			ks = ks[:m]
+		}
+		type c struct {
+			Key          string
+			LastModified string
+		}
+		var out struct {
+			XMLName  xml.Name `xml:"ListBucketResult"`
+			Contents []c
+		}
+		for _, k := range ks {
+			out.Contents = append(out.Contents, c{k, f.mod[k].UTC().Format(time.RFC3339)})
+		}
+		xml.NewEncoder(w).Encode(out)
+	case r.Method == "GET":
+		f.gets.Add(1)
+		b, ok := f.objs[key]
+		if !ok {
+			w.WriteHeader(404)
+			return
+		}
+		w.Write(b)
+	}
+}
+
+func pair(t *testing.T, lat time.Duration) (*Box, *Box, *fakeS3) {
+	f := &fakeS3{objs: map[string][]byte{}, mod: map[string]time.Time{}, lat: lat}
+	srv := httptest.NewServer(f)
+	t.Cleanup(srv.Close)
+	u := "s3://AK:SK@" + strings.TrimPrefix(srv.URL, "http://") + "/bkt/t1"
+	u = strings.Replace(u, "s3://", "s3://", 1)
+	base := transport.DefaultConfig()
+	cl, err := New("s3", strings.Replace(u, "s3://", "http://", 1), base, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ex, _ := New("s3", strings.Replace(u, "s3://", "http://", 1), base, true)
+	return cl, ex, f
+}
+
+func TestTunnelBothWays(t *testing.T) {
+	cl, ex, f := pair(t, 20*time.Millisecond)
+	var gotEx, gotCl [][]byte
+	var mu sync.Mutex
+	ex.Receive(func(p []byte) {
+		mu.Lock()
+		gotEx = append(gotEx, p)
+		mu.Unlock()
+		ex.Send(append([]byte("ответ:"), p...))
+	})
+	cl.Receive(func(p []byte) { mu.Lock(); gotCl = append(gotCl, p); mu.Unlock() })
+	ex.Start()
+	cl.Start()
+	defer cl.Stop()
+	defer ex.Stop()
+	for i := 0; i < 50; i++ {
+		cl.Send([]byte(fmt.Sprintf("пакет %03d", i)))
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		mu.Lock()
+		n := len(gotCl)
+		mu.Unlock()
+		if n == 50 {
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(gotEx) != 50 || len(gotCl) != 50 {
+		t.Fatalf("дошло %d туда и %d обратно", len(gotEx), len(gotCl))
+	}
+	for i := range gotEx {
+		if string(gotEx[i]) != fmt.Sprintf("пакет %03d", i) {
+			t.Fatalf("нарушен порядок: %q на месте %d", gotEx[i], i)
+		}
+	}
+	if !cl.IsConnected() || !ex.IsConnected() {
+		t.Fatal("не отмечено подключение")
+	}
+	t.Logf("запросов: PUT %d, GET %d, LIST %d", f.puts.Load(), f.gets.Load(), f.lists.Load())
+}
+
+func TestThroughput(t *testing.T) {
+	cl, ex, f := pair(t, 40*time.Millisecond) // как задержка до облака по мобильной сети
+	var got atomic.Int64
+	ex.Receive(func(p []byte) { got.Add(int64(len(p))) })
+	ex.Start()
+	cl.Start()
+	defer cl.Stop()
+	defer ex.Stop()
+	pkt := make([]byte, 1400)
+	rand.Read(pkt)
+	const total = 40 << 20
+	t0 := time.Now()
+	go func() {
+		for sent := 0; sent < total; sent += len(pkt) {
+			for cl.Send(pkt) != nil {
+				time.Sleep(time.Millisecond)
+			}
+		}
+	}()
+	for got.Load() < total*99/100 && time.Since(t0) < 60*time.Second {
+		time.Sleep(10 * time.Millisecond)
+	}
+	d := time.Since(t0)
+	t.Logf("СКОРОСТЬ через ящик (задержка 40 мс на запрос): %.1f Мбит/с, %d МБ за %v; PUT %d GET %d", float64(got.Load()*8)/d.Seconds()/1e6, got.Load()>>20, d.Round(time.Millisecond), f.puts.Load(), f.gets.Load())
+	if got.Load() < total*99/100 {
+		t.Fatal("не всё дошло")
+	}
+}
+
+func TestRestartAndStale(t *testing.T) {
+	la, le := listAfter, listEvery
+	listAfter, listEvery = time.Second, time.Second
+	defer func() { listAfter, listEvery = la, le }()
+	cl, ex, _ := pair(t, 5*time.Millisecond)
+	var got atomic.Int64
+	ex.Receive(func(p []byte) { got.Add(1) })
+	ex.Start()
+	defer ex.Stop()
+	cl.Start()
+	cl.Send([]byte("до перезапуска"))
+	time.Sleep(500 * time.Millisecond)
+	cl.Stop()
+	// клиент перезапустился: новая серия номеров
+	cl2, _ := New("s3", "http://AK:SK@"+strings.TrimPrefix(cl.s3.endpoint, "http://")+"/bkt/t1", transport.DefaultConfig(), false)
+	cl2.Start()
+	defer cl2.Stop()
+	cl2.Send([]byte("после"))
+	for i := 0; i < 200 && got.Load() < 2; i++ {
+		time.Sleep(50 * time.Millisecond)
+	}
+	if got.Load() != 2 {
+		t.Fatalf("после перезапуска клиента дошло %d из 2", got.Load())
+	}
+}
+
+func TestBadKey(t *testing.T) {
+	f := &fakeS3{objs: map[string][]byte{}, mod: map[string]time.Time{}}
+	srv := httptest.NewServer(f)
+	defer srv.Close()
+	b, _ := New("s3", "http://WRONG:SK@"+strings.TrimPrefix(srv.URL, "http://")+"/bkt/t1", transport.DefaultConfig(), false)
+	b.Start()
+	defer b.Stop()
+	b.Send([]byte("x"))
+	time.Sleep(300 * time.Millisecond)
+	if b.IsConnected() {
+		t.Fatal("с неверным ключом не должно быть подключения")
+	}
+	_ = bytes.MinRead
+}
+
+// Сколько платных запросов уходит: поток 4 МБ/с и простой со служебными пакетами.
+func TestCostProfile(t *testing.T) {
+	cl, ex, f := pair(t, 30*time.Millisecond)
+	var got atomic.Int64
+	ex.Receive(func(p []byte) { got.Add(int64(len(p))) })
+	cl.Receive(func(p []byte) {})
+	ex.Start()
+	cl.Start()
+	defer cl.Stop()
+	defer ex.Stop()
+	time.Sleep(300 * time.Millisecond)
+	// поток: 4 МБ/с пакетами по 1400 байт в течение 3 с
+	pkt := make([]byte, 1400)
+	p0, g0 := f.puts.Load(), f.gets.Load()
+	t0 := time.Now()
+	for time.Since(t0) < 3*time.Second {
+		for i := 0; i < 30; i++ {
+			for cl.Send(pkt) != nil {
+				time.Sleep(time.Millisecond)
+			}
+		}
+		time.Sleep(10 * time.Millisecond) // ~4 МБ/с
+	}
+	time.Sleep(500 * time.Millisecond)
+	mb := float64(got.Load()) / 1e6
+	t.Logf("ПОТОК: %.1f МБ, PUT %d (%.1f на МБ), GET %d", mb, f.puts.Load()-p0, float64(f.puts.Load()-p0)/mb, f.gets.Load()-g0)
+	// простой: служебный пакет раз в 2 с, 12 с
+	time.Sleep(4 * time.Second) // темп успокаивается
+	p1, g1, l1 := f.puts.Load(), f.gets.Load(), f.lists.Load()
+	t1 := time.Now()
+	for time.Since(t1) < 12*time.Second {
+		cl.Send([]byte("keepalive"))
+		time.Sleep(2 * time.Second)
+	}
+	d := time.Since(t1).Seconds()
+	t.Logf("ПРОСТОЙ: в секунду PUT %.2f, GET %.2f (обе стороны), LIST за 12 с: %d", float64(f.puts.Load()-p1)/d, float64(f.gets.Load()-g1)/d, f.lists.Load()-l1)
+}
diff --git a/transport/s3box/s3.go b/transport/s3box/s3.go
new file mode 100644
index 0000000..1a5c7cf
--- /dev/null
+++ b/transport/s3box/s3.go
@@ -0,0 +1,268 @@
+package s3box
+
+// Минимальный клиент S3 (подпись AWS Signature V4) только на стандартной библиотеке:
+// PUT, GET, DELETE и ListObjectsV2. Подходит для Yandex Object Storage
+// (storage.yandexcloud.net) и VK Cloud (hb.ru-msk.vkcs.cloud).
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+	"time"
+)
+
+type s3Client struct {
+	endpoint string // https://host
+	host     string
+	bucket   string
+	region   string
+	ak, sk   string
+	hc       *http.Client
+	now      func() time.Time
+}
+
+var errNotFound = errors.New("s3: not found")
+
+type httpError struct {
+	code int
+	body string
+}
+
+func (e *httpError) Error() string { return fmt.Sprintf("s3: HTTP %d %s", e.code, e.body) }
+
+func newS3(host, bucket, region, ak, sk string) *s3Client {
+	tr := &http.Transport{
+		Proxy:               nil,
+		MaxIdleConns:        64,
+		MaxIdleConnsPerHost: 32,
+		IdleConnTimeout:     90 * time.Second,
+		ForceAttemptHTTP2:   true,
+		TLSHandshakeTimeout: 10 * time.Second,
+	}
+	scheme := "https://"
+	if strings.HasPrefix(host, "http://") {
+		scheme, host = "http://", strings.TrimPrefix(host, "http://")
+	}
+	return &s3Client{
+		endpoint: scheme + host, host: host, bucket: bucket, region: region, ak: ak, sk: sk,
+		hc:  &http.Client{Transport: tr, Timeout: 30 * time.Second},
+		now: time.Now,
+	}
+}
+
+// uriEncode по правилам SigV4: всё, кроме A-Z a-z 0-9 - _ . ~, кодируется; '/' — по флагу
+func uriEncode(s string, slash bool) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' || (c == '/' && !slash) {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+func hmacSHA(key []byte, s string) []byte {
+	m := hmac.New(sha256.New, key)
+	m.Write([]byte(s))
+	return m.Sum(nil)
+}
+
+func sha256hex(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+
+// sign вычисляет заголовок Authorization (SigV4). headers — уже со всеми подписываемыми заголовками.
+func sign(method, path string, query url.Values, headers map[string]string, payloadHash, region, ak, sk string, t time.Time) string {
+	amzDate := t.UTC().Format("20060102T150405Z")
+	day := amzDate[:8]
+	// канонический запрос
+	keys := make([]string, 0, len(query))
+	for k := range query {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var cq []string
+	for _, k := range keys {
+		vs := append([]string{}, query[k]...)
+		sort.Strings(vs)
+		for _, v := range vs {
+			cq = append(cq, uriEncode(k, true)+"="+uriEncode(v, true))
+		}
+	}
+	hk := make([]string, 0, len(headers))
+	for k := range headers {
+		hk = append(hk, strings.ToLower(k))
+	}
+	sort.Strings(hk)
+	lower := map[string]string{}
+	for k, v := range headers {
+		lower[strings.ToLower(k)] = strings.TrimSpace(v)
+	}
+	var ch strings.Builder
+	for _, k := range hk {
+		ch.WriteString(k + ":" + lower[k] + "\n")
+	}
+	signed := strings.Join(hk, ";")
+	creq := method + "\n" + uriEncode(path, false) + "\n" + strings.Join(cq, "&") + "\n" + ch.String() + "\n" + signed + "\n" + payloadHash
+	scope := day + "/" + region + "/s3/aws4_request"
+	sts := "AWS4-HMAC-SHA256\n" + amzDate + "\n" + scope + "\n" + sha256hex([]byte(creq))
+	k := hmacSHA([]byte("AWS4"+sk), day)
+	k = hmacSHA(k, region)
+	k = hmacSHA(k, "s3")
+	k = hmacSHA(k, "aws4_request")
+	sig := hex.EncodeToString(hmacSHA(k, sts))
+	return "AWS4-HMAC-SHA256 Credential=" + ak + "/" + scope + ", SignedHeaders=" + signed + ", Signature=" + sig
+}
+
+func (c *s3Client) do(ctx context.Context, method, key string, query url.Values, body []byte) (*http.Response, []byte, error) {
+	path := "/" + c.bucket
+	if key != "" {
+		path += "/" + key
+	}
+	if query == nil {
+		query = url.Values{}
+	}
+	ph := sha256hex(body)
+	t := c.now()
+	h := map[string]string{
+		"host":                 c.host,
+		"x-amz-content-sha256": ph,
+		"x-amz-date":           t.UTC().Format("20060102T150405Z"),
+	}
+	u := c.endpoint + uriEncode(path, false)
+	if len(query) > 0 {
+		var parts []string
+		for k, vs := range query {
+			for _, v := range vs {
+				parts = append(parts, uriEncode(k, true)+"="+uriEncode(v, true))
+			}
+		}
+		sort.Strings(parts)
+		u += "?" + strings.Join(parts, "&")
+	}
+	req, err := http.NewRequestWithContext(ctx, method, u, bytes.NewReader(body))
+	if err != nil {
+		return nil, nil, err
+	}
+	req.ContentLength = int64(len(body))
+	for k, v := range h {
+		if k != "host" {
+			req.Header.Set(k, v)
+		}
+	}
+	req.Header.Set("Authorization", sign(method, path, query, h, ph, c.region, c.ak, c.sk, t))
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer resp.Body.Close()
+	rb, err := io.ReadAll(io.LimitReader(resp.Body, 64<<20))
+	if err != nil {
+		return resp, nil, err
+	}
+	return resp, rb, nil
+}
+
+func (c *s3Client) put(ctx context.Context, key string, body []byte) error {
+	resp, rb, err := c.do(ctx, http.MethodPut, key, nil, body)
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode/100 != 2 {
+		return &httpError{resp.StatusCode, short(rb)}
+	}
+	return nil
+}
+
+func (c *s3Client) get(ctx context.Context, key string) ([]byte, error) {
+	resp, rb, err := c.do(ctx, http.MethodGet, key, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode == http.StatusNotFound {
+		return nil, errNotFound
+	}
+	if resp.StatusCode/100 != 2 {
+		return nil, &httpError{resp.StatusCode, short(rb)}
+	}
+	return rb, nil
+}
+
+func (c *s3Client) del(ctx context.Context, key string) error {
+	resp, rb, err := c.do(ctx, http.MethodDelete, key, nil, nil)
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode/100 != 2 && resp.StatusCode != http.StatusNotFound {
+		return &httpError{resp.StatusCode, short(rb)}
+	}
+	return nil
+}
+
+type listed struct {
+	Key string
+	Age time.Duration // насколько объект старше ответа сервера
+}
+
+type listResult struct {
+	Contents []struct {
+		Key          string `xml:"Key"`
+		LastModified string `xml:"LastModified"`
+	} `xml:"Contents"`
+}
+
+// list возвращает ключи с префиксом (по возрастанию), не больше max
+func (c *s3Client) list(ctx context.Context, prefix, startAfter string, max int) ([]listed, error) {
+	q := url.Values{"list-type": {"2"}, "prefix": {prefix}, "max-keys": {fmt.Sprint(max)}}
+	if startAfter != "" {
+		q.Set("start-after", startAfter)
+	}
+	resp, rb, err := c.do(ctx, http.MethodGet, "", q, nil)
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode/100 != 2 {
+		return nil, &httpError{resp.StatusCode, short(rb)}
+	}
+	var lr listResult
+	if err := xml.Unmarshal(rb, &lr); err != nil {
+		return nil, err
+	}
+	now := time.Now()
+	if d, err := http.ParseTime(resp.Header.Get("Date")); err == nil {
+		now = d
+	}
+	out := make([]listed, 0, len(lr.Contents))
+	for _, o := range lr.Contents {
+		age := time.Duration(0)
+		if t, err := time.Parse(time.RFC3339, o.LastModified); err == nil {
+			age = now.Sub(t)
+		}
+		out = append(out, listed{Key: o.Key, Age: age})
+	}
+	return out, nil
+}
+
+func short(b []byte) string {
+	s := strings.TrimSpace(string(b))
+	if i := strings.Index(s, "<Code>"); i >= 0 {
+		if j := strings.Index(s[i:], "</Code>"); j > 0 {
+			return s[i+6 : i+j]
+		}
+	}
+	if len(s) > 120 {
+		s = s[:120]
+	}
+	return s
+}
