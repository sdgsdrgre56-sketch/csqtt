+// Package s3box — транспорт «Пульс через облако»: две стороны обмениваются пачками
+// пакетов через объектное хранилище S3 (Yandex Object Storage, VK Cloud), как через
+// почтовый ящик. Для оператора это обычная загрузка и скачивание файлов в облако.
+//
+// Каждая сторона пишет в свою папку: клиент в <prefix>/c/, нода в <prefix>/e/.
+// Имя объекта — 16-значный шестнадцатеричный номер; первый номер берётся из часов
+// (микросекунды), поэтому после перезапуска номера только растут и получатель видит
+// новую серию. Получатель читает строго по порядку, заранее запрашивает следующие
+// объекты, когда данные идут потоком, и удаляет прочитанное.
+//
+// Тело объекта: версия (1 байт) + пакеты в виде uvarint(длина) | данные.
+// Шифрование делает слой OpenFlux над транспортом (общий ключ профиля).
+package s3box
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"log"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/p1neappleXpress/OpenFlux/transport"
+)
+
+const bodyVersion = 1
+
+// Настройки темпа. Каждый запрос к облаку платный (PUT/LIST дороже GET),
+// поэтому пачки крупнее и опросы реже там, где это не заметно на глаз.
+var (
+	maxBatch    = 1 << 20               // байт в одном объекте
+	coalesce    = 10 * time.Millisecond // обычное окно сбора пачки
+	bulkWindow  = 40 * time.Millisecond // окно при потоке (видео, загрузки): пачки по сотни КБ
+	quickPoll   = 3 * time.Second       // столько после настоящих данных опрашиваем часто
+	maxInflight = 8                     // одновременных загрузок
+	maxPrefetch = 16
+	minPoll     = 15 * time.Millisecond
+	busyPoll    = 250 * time.Millisecond
+	calmPoll    = time.Second
+	idlePoll    = 2 * time.Second // без трафика больше минуты — реже спрашиваем облако (GET платные)
+	gapSkip     = 6 * time.Second
+	listAfter   = 15 * time.Second // собеседник шлёт служебный пакет раз в 10 с: дольше тишины — проверяем, не перезапустился ли он
+	listEvery   = 5 * time.Second  // как часто в такой тишине проверять (обычными GET)
+	realData    = 1500             // пачка меньше — служебная, ради неё не ускоряемся
+	staleAge    = 90 * time.Second
+)
+
+// Presets — облака, которые открываются в «белых списках» мобильных операторов.
+var Presets = map[string]struct{ Host, Region string }{
+	"ycloud":  {"storage.yandexcloud.net", "ru-central1"},
+	"vkcloud": {"hb.ru-msk.vkcs.cloud", "ru-msk"},
+}
+
+// Config разобранный адрес ящика.
+type Config struct {
+	Host, Region, Bucket, Prefix, AK, SK string
+}
+
+// ParseURL понимает s3://КЛЮЧ:СЕКРЕТ@хост/бакет/папка?region=...
+// Для типов ycloud/vkcloud хост и регион можно не писать: КЛЮЧ:СЕКРЕТ@бакет/папка.
+func ParseURL(typ, raw string) (Config, error) {
+	var c Config
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return c, errors.New("s3box: пустой адрес ящика")
+	}
+	scheme := "s3"
+	if i := strings.Index(raw, "://"); i >= 0 {
+		scheme, raw = strings.ToLower(raw[:i]), raw[i+3:]
+	}
+	// ключ и секрет — до последней @ (в секрете бывают / и +)
+	at := strings.LastIndexByte(raw, '@')
+	if at < 0 {
+		return c, errors.New("s3box: в адресе нет ключа доступа (КЛЮЧ:СЕКРЕТ@...)")
+	}
+	cred, rest := raw[:at], raw[at+1:]
+	colon := strings.IndexByte(cred, ':')
+	if colon < 0 {
+		return c, errors.New("s3box: ключ и секрет пишутся через двоеточие")
+	}
+	unesc := func(v string) string {
+		if u, err := url.PathUnescape(v); err == nil {
+			return u
+		}
+		return v
+	}
+	c.AK, c.SK = unesc(cred[:colon]), unesc(cred[colon+1:])
+	query := ""
+	if q := strings.IndexByte(rest, '?'); q >= 0 {
+		rest, query = rest[:q], rest[q+1:]
+	}
+	qv, _ := url.ParseQuery(query)
+	parts := strings.Split(strings.Trim(rest, "/"), "/")
+	pre, havePreset := Presets[typ]
+	if havePreset && !strings.Contains(parts[0], ".") {
+		// КЛЮЧ:СЕКРЕТ@бакет/папка
+		c.Host, c.Region, c.Bucket = pre.Host, pre.Region, parts[0]
+		c.Prefix = strings.Join(parts[1:], "/")
+	} else {
+		c.Host = parts[0]
+		if scheme == "http" {
+			c.Host = "http://" + parts[0]
+		}
+		if len(parts) < 2 || parts[1] == "" {
+			return c, errors.New("s3box: в адресе нет имени бакета")
+		}
+		c.Bucket, c.Prefix = parts[1], strings.Join(parts[2:], "/")
+		if havePreset {
+			c.Region = pre.Region
+		}
+	}
+	if r := qv.Get("region"); r != "" {
+		c.Region = r
+	}
+	if c.Region == "" {
+		c.Region = "us-east-1"
+	}
+	if c.AK == "" || c.SK == "" || c.Bucket == "" {
+		return c, errors.New("s3box: нужны ключ, секрет и бакет")
+	}
+	if c.Prefix == "" {
+		c.Prefix = "pulse"
+	}
+	return c, nil
+}
+
+// Box — транспорт OpenFlux поверх S3.
+type Box struct {
+	*transport.BaseTransport
+	cfg     Config
+	s3      *s3Client
+	outDir  string
+	inDir   string
+	sendQ   chan []byte
+	ctx     context.Context
+	cancel  context.CancelFunc
+	wg      sync.WaitGroup
+	nextOut atomic.Uint64
+	lastErr atomic.Value
+}
+
+// New создаёт транспорт. isExit — роль процесса (нода пишет в e/, клиент в c/).
+func New(typ, rawURL string, base transport.TransportConfig, isExit bool) (*Box, error) {
+	c, err := ParseURL(typ, rawURL)
+	if err != nil {
+		return nil, err
+	}
+	b := &Box{BaseTransport: transport.NewBaseTransport(base), cfg: c, s3: newS3(c.Host, c.Bucket, c.Region, c.AK, c.SK)}
+	b.outDir, b.inDir = c.Prefix+"/c/", c.Prefix+"/e/"
+	if isExit {
+		b.outDir, b.inDir = b.inDir, b.outDir
+	}
+	q := base.MaxQueueSize
+	if q < 64 {
+		q = 1024
+	}
+	b.sendQ = make(chan []byte, q)
+	return b, nil
+}
+
+func key(dir string, seq uint64) string { return fmt.Sprintf("%s%016x", dir, seq) }
+
+func seqOf(k string) (uint64, bool) {
+	i := strings.LastIndexByte(k, '/')
+	v, err := strconv.ParseUint(k[i+1:], 16, 64)
+	return v, err == nil
+}
+
+func (b *Box) Start() error {
+	if err := b.BaseTransport.Start(); err != nil {
+		return err
+	}
+	b.ctx, b.cancel = context.WithCancel(context.Background())
+	start := uint64(time.Now().UnixMicro())
+	b.nextOut.Store(start)
+	b.wg.Add(3)
+	go func() { defer b.wg.Done(); b.writeHead(start) }()
+	go b.writeLoop()
+	go b.readLoop()
+	return nil
+}
+
+func (b *Box) Stop() error {
+	if b.cancel != nil {
+		b.cancel()
+	}
+	err := b.BaseTransport.Stop()
+	b.wg.Wait()
+	return err
+}
+
+// Send ставит пакет в очередь; пачки уходят в облако каждые ~2 мс или по 1 МБ.
+func (b *Box) Send(data []byte) error {
+	if !b.IsRunning() {
+		return errors.New("s3box: транспорт остановлен")
+	}
+	p := append([]byte(nil), data...)
+	select {
+	case b.sendQ <- p:
+		b.RecordSend(len(data))
+		return nil
+	default:
+		return errors.New("s3box: очередь переполнена")
+	}
+}
+
+func (b *Box) fail(err error) {
+	if err == nil || errors.Is(err, context.Canceled) {
+		return
+	}
+	prev, _ := b.lastErr.Load().(string)
+	if prev != err.Error() {
+		b.lastErr.Store(err.Error())
+		log.Printf("s3box %s: %v", b.cfg.Host, err)
+	}
+	var he *httpError
+	if errors.As(err, &he) && (he.code == 401 || he.code == 403) {
+		b.SetConnected(false)
+	}
+}
+
+func (b *Box) ok() {
+	if !b.IsConnected() {
+		b.SetConnected(true)
+		b.lastErr.Store("")
+	}
+}
+
+func (b *Box) writeLoop() {
+	defer b.wg.Done()
+	sem := make(chan struct{}, maxInflight)
+	var puts sync.WaitGroup
+	defer puts.Wait()
+	buf := make([]byte, 0, 64<<10)
+	lastBig := false
+	for {
+		var first []byte
+		select {
+		case <-b.ctx.Done():
+			return
+		case first = <-b.sendQ:
+		}
+		buf = append(buf[:0], bodyVersion)
+		add := func(p []byte) {
+			buf = binary.AppendUvarint(buf, uint64(len(p)))
+			buf = append(buf, p...)
+		}
+		add(first)
+		win := coalesce
+		if lastBig {
+			win = bulkWindow
+		}
+		timer := time.NewTimer(win)
+	gather:
+		for len(buf) < maxBatch {
+			select {
+			case p := <-b.sendQ:
+				add(p)
+			case <-timer.C:
+				break gather
+			case <-b.ctx.Done():
+				timer.Stop()
+				return
+			}
+		}
+		timer.Stop()
+		lastBig = len(buf) > 64<<10
+		body := append([]byte(nil), buf...)
+		seq := b.nextOut.Add(1) - 1
+		select {
+		case sem <- struct{}{}:
+		case <-b.ctx.Done():
+			return
+		}
+		puts.Add(1)
+		go func(seq uint64, body []byte) {
+			defer func() { <-sem; puts.Done() }()
+			k := key(b.outDir, seq)
+			delay := 100 * time.Millisecond
+			for attempt := 0; attempt < 6; attempt++ {
+				err := b.s3.put(b.ctx, k, body)
+				if err == nil {
+					b.ok()
+					return
+				}
+				b.fail(err)
+				select {
+				case <-b.ctx.Done():
+					return
+				case <-time.After(delay):
+				}
+				delay *= 2
+			}
+		}(seq, body)
+	}
+}
+
+type getRes struct {
+	data []byte
+	err  error
+}
+
+// headKey — объект с номером, с которого пишет текущий запуск стороны. Его читают
+// обычным (дешёвым) GET вместо дорогого LIST: так получатель находит серию при старте
+// и замечает перезапуск собеседника.
+func headKey(dir string) string { return dir + "head" }
+
+// writeHead публикует начало своей серии (с повторами, пока не получится).
+func (b *Box) writeHead(start uint64) {
+	delay := 200 * time.Millisecond
+	for b.ctx.Err() == nil {
+		if err := b.s3.put(b.ctx, headKey(b.outDir), []byte(fmt.Sprintf("%016x", start))); err == nil {
+			b.ok()
+			return
+		} else {
+			b.fail(err)
+		}
+		select {
+		case <-b.ctx.Done():
+			return
+		case <-time.After(delay):
+		}
+		if delay < 5*time.Second {
+			delay *= 2
+		}
+	}
+}
+
+func (b *Box) readHead() (uint64, error) {
+	d, err := b.s3.get(b.ctx, headKey(b.inDir))
+	if err != nil {
+		return 0, err
+	}
+	v, err := strconv.ParseUint(strings.TrimSpace(string(d)), 16, 64)
+	if err != nil {
+		return 0, errNotFound
+	}
+	return v, nil
+}
+
+// cleanup один раз при старте убирает хвосты прошлых запусков собеседника.
+func (b *Box) cleanup() {
+	items, err := b.s3.list(b.ctx, b.inDir, "", 1000)
+	if err != nil {
+		return
+	}
+	for _, it := range items {
+		if _, good := seqOf(it.Key); good && it.Age > staleAge {
+			b.s3.del(context.Background(), it.Key)
+		}
+	}
+}
+
+func (b *Box) readLoop() {
+	defer b.wg.Done()
+	go b.cleanup()
+	var next, series uint64 // 0 — серия собеседника ещё не найдена
+	poll := minPoll
+	lastData := time.Now()
+	var waiting, lastCheck time.Time
+	window := 1
+	inflight := map[uint64]chan getRes{}
+	sleep := func(d time.Duration) bool {
+		select {
+		case <-b.ctx.Done():
+			return false
+		case <-time.After(d):
+			return true
+		}
+	}
+	growPoll := func() {
+		max := busyPoll
+		switch since := time.Since(lastData); {
+		case since > time.Minute:
+			max = idlePoll
+		case since > quickPoll:
+			max = calmPoll
+		}
+		poll = poll * 3 / 2
+		if poll > max {
+			poll = max
+		}
+	}
+	for b.ctx.Err() == nil {
+		if next == 0 {
+			h, err := b.readHead()
+			switch {
+			case err == nil:
+				b.ok()
+				next, series = h, h
+				continue
+			case errors.Is(err, errNotFound):
+				b.ok()
+			default:
+				b.fail(err)
+			}
+			growPoll()
+			if !sleep(poll) {
+				return
+			}
+			continue
+		}
+		for s := next; s < next+uint64(window); s++ {
+			if inflight[s] == nil {
+				ch := make(chan getRes, 1)
+				inflight[s] = ch
+				go func(s uint64) {
+					d, err := b.s3.get(b.ctx, key(b.inDir, s))
+					ch <- getRes{d, err}
+				}(s)
+			}
+		}
+		var r getRes
+		select {
+		case <-b.ctx.Done():
+			return
+		case r = <-inflight[next]:
+		}
+		delete(inflight, next)
+		switch {
+		case r.err == nil:
+			b.ok()
+			b.deliver(r.data)
+			go b.s3.del(context.Background(), key(b.inDir, next))
+			next++
+			waiting = time.Time{}
+			if len(r.data) >= realData {
+				// настоящий трафик: опрашиваем часто и читаем вперёд
+				poll, lastData = minPoll, time.Now()
+				if window < maxPrefetch {
+					window *= 2
+				}
+			} else {
+				window = 1 // служебный пакет: темп не меняем
+			}
+		case errors.Is(r.err, errNotFound):
+			b.ok()
+			inflight = map[uint64]chan getRes{} // ранние ответы «нет» уже устарели
+			window = 1
+			if waiting.IsZero() {
+				waiting = time.Now()
+			}
+			// Живой собеседник шлёт что-нибудь минимум раз в 10 с. Тишина дольше listAfter —
+			// дешёвыми GET проверяем, не перезапустился ли он (новая серия) и нет ли дыры
+			// (пачка, которую так и не удалось записать).
+			if time.Since(waiting) > listAfter && time.Since(lastCheck) > listEvery {
+				lastCheck = time.Now()
+				if h, err := b.readHead(); err == nil && h != series {
+					next, series, waiting = h, h, time.Time{}
+					continue
+				}
+				if _, err := b.s3.get(b.ctx, key(b.inDir, next+1)); err == nil {
+					next++ // дыра в одну пачку: пропускаем
+					continue
+				}
+			}
+			growPoll()
+			if !sleep(poll) {
+				return
+			}
+		default:
+			b.fail(r.err)
+			inflight = map[uint64]chan getRes{}
+			window = 1
+			if !sleep(time.Second) {
+				return
+			}
+		}
+	}
+}
+
+func (b *Box) deliver(body []byte) {
+	if len(body) < 1 || body[0] != bodyVersion {
+		return
+	}
+	p := body[1:]
+	for len(p) > 0 {
+		n, w := binary.Uvarint(p)
+		if w <= 0 || uint64(len(p)-w) < n {
+			return
+		}
+		pkt := p[w : w+int(n)]
+		p = p[w+int(n):]
+		b.RecordReceive(len(pkt))
+		b.CallReceive(append([]byte(nil), pkt...))
+	}
+}
