+// Alive tells whether the SSH connection still answers. Android destroys an
+// app's sockets when its network changes or the app is put to sleep in the
+// background; the next command then fails with nothing useful to show, so
+// callers check first and reopen the connection.
+func (c *Conn) Alive() bool {
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := c.client.SendRequest("keepalive@openssh.com", true, nil)
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		return err == nil
+	case <-time.After(8 * time.Second):
+		return false
+	}
+}
