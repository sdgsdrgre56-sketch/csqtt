+// SetNodeExitMode picks the exit backend of the channel the wizard plans and
+// installs next: "l3" for the raw-packet exit, anything else for the default
+// l4. A separate call, so the signatures of NodePlan and NodeApply stay as
+// the apps know them.
+func SetNodeExitMode(mode string) {
+	node.mu.Lock()
+	defer node.mu.Unlock()
+	if mode == "l3" {
+		node.exitMode = "l3"
+	} else {
+		node.exitMode = ""
+	}
+}
+
+func nodeExitMode() string {
+	node.mu.Lock()
+	defer node.mu.Unlock()
+	return node.exitMode
+}
+
